from functools import lru_cache
import random

WINS = [
    (0, 1, 2),
    (3, 4, 5),
    (6, 7, 8),
    (0, 3, 6),
    (1, 4, 7),
    (2, 5, 8),
    (0, 4, 8),
    (2, 4, 6),
]


def show_board(board):
    print()
    for i in range(0, 9, 3):
        row = []
        for j in range(3):
            cell = board[i + j]
            row.append(cell if cell != " " else str(i + j + 1))
        print(" | ".join(row))
        if i < 6:
            print("--+---+--")
    print()


def check_winner(board):
    for a, b, c in WINS:
        if board[a] != " " and board[b] == board[c] == board[a]:
            return board[a]
    return None


def is_full(board):
    return " " not in board


def player_move(board):
    while True:
        try:
            move = int(input("Enter your move (1-9): ")) - 1
            if move < 0 or move >= 9:
                print("Invalid input. Please enter a number between 1 and 9.")
                continue
            if board[move] != " ":
                print("Cell already taken. Choose another one.")
                continue
            board[move] = "X"
            break
        except ValueError:
            print("Invalid input. Please enter a number between 1 and 9.")


@lru_cache(maxsize=None)
def minimax(state, current):
    board = list(state)
    winner = check_winner(board)
    if winner == "X":
        return 1
    if winner == "O":
        return -1
    if " " not in board:
        return 0

    if current == "X":
        best = -2
        for i in range(9):
            if board[i] == " ":
                board[i] = "X"
                score = minimax("".join(board), "O")
                board[i] = " "
                best = max(best, score)
        return best
    else:
        best = 2
        for i in range(9):
            if board[i] == " ":
                board[i] = "O"
                score = minimax("".join(board), "X")
                board[i] = " "
                best = min(best, score)
        return best


def ai_move(board):
    best_score = 2
    best_moves = []

    for i in range(9):
        if board[i] == " ":
            board[i] = "O"
            score = minimax("".join(board), "X")
            board[i] = " "
            if score < best_score:
                best_score = score
                best_moves = [i]
            elif score == best_score:
                best_moves.append(i)

    idx = random.choice(best_moves)
    board[idx] = "O"
    print(f"AI chooses position {idx + 1}")
    show_board(board)


def play_round():
    board = [" "] * 9
    show_board(board)

    while True:
        player_move(board)
        show_board(board)
        winner = check_winner(board)
        if winner:
            print(f"{winner} wins!")
            break
        if is_full(board):
            print("It's a draw!")
            break

        ai_move(board)
        winner = check_winner(board)
        if winner:
            print(f"{winner} wins!")
            break
        if is_full(board):
            print("It's a draw!")
            break


